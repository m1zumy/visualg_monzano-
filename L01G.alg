algoritmo "L01G"

var
   a, b, c, d: inteiro

inicio

   escreva("Digite A: ")
   leia(a)

   escreva("Digite B: ")
   leia(b)

   escreva("Digite C: ")
   leia(c)

   escreva("Digite D: ")
   leia(d)

   escreval("A + B = ", a + b)
   escreval("A * B = ", a * b)

   escreval("A + C = ", a + c)
   escreval("A * C = ", a * c)

   escreval("A + D = ", a + d)
   escreval("A * D = ", a * d)

   escreval("B + C = ", b + c)
   escreval("B * C = ", b * c)

   escreval("B + D = ", b + d)
   escreval("B * D = ", b * d)

   escreval("C + D = ", c + d)
   escreval("C * D = ", c * d)

fimalgoritmo
