algoritmo "L01H"

var
   comprimento, largura, altura: real

inicio

   escreva("Digite o comprimento da caixa: ")
   leia(comprimento)

   escreva("Digite a largura da caixa: ")
   leia(largura)

   escreva("Digite a altura da caixa: ")
   leia(altura)

   escreva("O volume da caixa retangular é: ", comprimento * largura * altura)

fimalgoritmo
